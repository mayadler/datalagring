CREATE OR REPLACE FUNCTION check_teacher_max_courses()
RETURNS TRIGGER AS $$
BEGIN
    IF (
        SELECT COUNT(DISTINCT pa.course_instance_id)
        FROM planned_activity_employee pa
        JOIN course_instance ci
          ON pa.course_instance_id = ci.course_instance_id
        WHERE pa.employee_id = NEW.employee_id
          AND ci.study_period = (SELECT study_period 
                                 FROM course_instance 
                                 WHERE course_instance_id = NEW.course_instance_id)
          AND ci.study_year = (SELECT study_year 
                               FROM course_instance 
                               WHERE course_instance_id = NEW.course_instance_id)
    ) >= 4 THEN
        RAISE EXCEPTION 'Teacher % cannot be allocated more than 4 courses in the same period', NEW.employee_id;
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


CREATE TRIGGER trg_check_teacher_max_courses
BEFORE INSERT OR UPDATE ON planned_activity_employee
FOR EACH ROW
EXECUTE FUNCTION check_teacher_max_courses();









