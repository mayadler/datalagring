SELECT
    CL.course_code AS "Course Code",
    CI.course_instance_id AS "Course Instance ID",
    CL.hp AS "HP",
    CI.study_period AS "Period",
     P.first_name || ' ' || P.last_name AS "Teacher's Name",
SUM(CASE WHEN ta.teaching_activity_id = '1' THEN pa.planned_hours * ta.factor::numeric ELSE 0 END) AS lecture,
SUM(CASE WHEN ta.teaching_activity_id = '2' THEN pa.planned_hours * ta.factor::numeric ELSE 0 END) AS lab,
SUM(CASE WHEN ta.teaching_activity_id = '3' THEN pa.planned_hours * ta.factor::numeric ELSE 0 END) AS tutorial,
SUM(CASE WHEN ta.teaching_activity_id = '4' THEN pa.planned_hours * ta.factor::numeric ELSE 0 END) AS seminar,
SUM(CASE WHEN ta.teaching_activity_id NOT IN ('1','2','3','4','6','7') 
             THEN pa.planned_hours * ta.factor::numeric ELSE 0 END) AS other,
SUM(CASE WHEN ta.teaching_activity_id = '6' THEN 32 + 0.725 * ci.num_students ELSE 0 END)AS examination,
SUM(CASE WHEN ta.teaching_activity_id = '7' THEN 2 * cl.hp::numeric + 28 + (0.2* ci.num_students) ELSE 0 END) AS administration,
SUM(PA.planned_hours * TA.factor::numeric) AS "Total"
FROM
    course_layout CL,
    course_instance CI,
    planned_activity PA,
    teaching_activity TA,
    planned_activity_employee PAE,
    employee E,
    person P
WHERE
    CL.course_code = CI.course_code AND
    CI.course_instance_id = PA.course_instance_id AND
    PA.teaching_activity_id = TA.teaching_activity_id AND
    PA.course_instance_id = PAE.course_instance_id AND
    PA.teaching_activity_id = PAE.teaching_activity_id AND
    PAE.employee_id = E.employee_id AND
    E.person_id = P.person_id AND
  CI.study_year = '2025' AND 
p.first_name = 'Niharika' AND
p.last_name= 'Gauraha'
GROUP BY
    CL.course_code,
    CI.course_instance_id,
    CL.hp,
    CI.study_period,
    P.first_name,
    P.last_name;
